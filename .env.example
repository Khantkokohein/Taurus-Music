# Server-only Gemini credentials. Put real values in a Vercel Sensitive
# Environment Variable or .env.local. Never use a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MUSIC_MODEL=lyria-3-pro-preview

# Private preview mode. Fail closed unless the verified Firebase UID is listed.
APP_MODE=personal
PERSONAL_ALLOWED_UIDS=

# Keyless Vercel -> Google Cloud authentication.
# These are identifiers, not private keys. Scope production and preview separately.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_AUDIENCE=
GCP_VERTEX_LOCATION=us-central1
GCP_STORAGE_BUCKET=

# Optional local ADC fallback. Do not commit credential files.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=

# Public Firebase web identifiers. These are bundled into the Vite client.
# Restrict the Firebase web API key by API and authorized domain.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIRESTORE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-controlled generation limits. Clients must never set these values.
GENERATION_CREDIT_COST=5
GENERATION_RATE_LIMIT_PER_MINUTE=4

# Public application origin only.
APP_URL=

# TaurusPay migration variables. Real values belong in Vercel only.
PAYMENTS_ENABLED=false
TAURUSPAY_BASE_URL=
TAURUSPAY_API_KEY=
TAURUSPAY_WEBHOOK_SECRET=
TAURUSPAY_USDT_ADDRESS=
TAURUSPAY_CALLBACK_URL=
TAURUSPAY_PRODUCTS_JSON=

# Telegram bot webhook. Keep both values server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OWNER_USER_IDS=

# Public Telegram bot username only. Never put the bot token in VITE_*.
VITE_TELEGRAM_BOT_USERNAME=

# Legacy migration fallback only. Prefer Vercel OIDC and remove afterward.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Internal FFmpeg editor service. Keep both values server-only.
AUDIO_TOOLS_URL=
AUDIO_TOOLS_SECRET=
AUDIO_SOURCE_HOSTS=firebasestorage.googleapis.com,storage.googleapis.com
